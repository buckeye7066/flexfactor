{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flexfactor.local/schemas/purpose-contract.v2.json",
  "title": "FlexFactor Purpose Contract",
  "$comment": "Before a v2 contract can authorize mutation, runtime validation additionally requires every claim evidence_refs index to resolve to top-level evidence and every required users/outcomes/workflows/invariants claim to be verified or supported.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "purpose", "users", "outcomes", "workflows", "invariants", "acceptance_criteria", "evidence"],
  "properties": {
    "schema": { "const": "flexfactor.purpose_contract.v2" },
    "name": { "type": "string", "minLength": 1 },
    "historical_purpose": { "type": "string" },
    "purpose": { "type": "string", "minLength": 1 },
    "current_behavior": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "aspirations": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "users": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/claim" } },
    "outcomes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/claim" } },
    "workflows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/claim" } },
    "invariants": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/claim" } },
    "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "contradictions": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "resolved_contradictions": { "type": "array", "items": { "$ref": "#/$defs/resolved_claim" },
                                 "description": "Contradictions that HAVE been closed, kept together with the decision that closed them. An empty `contradictions` list is only trustworthy if the closures are auditable - deleting an entry is indistinguishable from never having found it." },
    "gaps": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
    "false_substitutes": { "type": "array", "items": { "type": "string", "minLength": 1 },
                           "description": "Observations that must NEVER be read as completion (build passes, page loads, merged, HTTP 200, ...)." },
    "slug": { "type": "string", "minLength": 1 },
    "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator", "content_hash", "observed_at"],
      "properties": {
        "kind": { "enum": ["source", "documentation", "history", "issue", "pull_request", "test", "route", "schema", "runtime"] },
        "locator": { "type": "string", "minLength": 1 },
        "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "observed_at": { "type": "string", "format": "date-time" },
        "excerpt": { "type": "string" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "confidence", "evidence_refs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["verified", "supported", "inferred", "contradicted", "unknown"] },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 },
                           "$comment": "Runtime validation also requires every index to resolve to this contract's top-level evidence array." }
      }
    },
    "resolved_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "resolution", "confidence", "evidence_refs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "resolution": { "type": "string", "minLength": 1,
                        "description": "Which side was correct - the DOCUMENTED behaviour or the IMPLEMENTED behaviour - and why. A contradiction is not closed by deleting it; the reader must be able to audit the decision." },
        "confidence": { "enum": ["verified", "supported", "inferred", "contradicted", "unknown"] },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 },
                           "$comment": "Runtime validation also requires every index to resolve to this contract's top-level evidence array." }
      }
    }
  }
}
