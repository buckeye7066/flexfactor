# FlexFactor configuration surface - copy to .env and fill in what you need.
#
# NOTHING HERE IS REQUIRED TO START. FlexFactor's default path is free: it
# prefers the local FCC proxy / Ollama / AI Time's free route catalog, and a
# paid key is only ever a rescue. Every variable below is optional, and the
# defaults are the ones the tool actually ships with.
#
# This file is the tracked template; `.env` itself is git-ignored. Values are
# read from the PROCESS ENVIRONMENT (FlexFactor does not load .env itself - use
# your shell, your launcher, or a tool like direnv).
#
# Verified against the source on 2026-08-23: every name below is read by
# flexfactor*.py. Grep before adding one here, or this file becomes fiction.

# --------------------------------------------------------------------------- #
# Provider credentials - all optional; free routes need none of them
# --------------------------------------------------------------------------- #
# Paid cloud keys. With the FCC proxy active these are preserved as the PAID
# RESCUE keys rather than the primary path (see FLEXFACTOR_FALLBACK_* below).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# GitHub OAuth/fine-grained token accepted by Copilot CLI for desktop use. The
# Android runner uses its short-lived, repository-scoped GITHUB_TOKEN instead.
COPILOT_GITHUB_TOKEN=

# Point the Anthropic client at a local proxy instead of the vendor. The FCC
# proxy at http://127.0.0.1:8082 is auto-detected; set these only to override.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=

# Explicit paid-rescue keys. FlexFactor moves a real key here itself when it
# activates the free proxy, so a rescue still has something to call.
FLEXFACTOR_FALLBACK_ANTHROPIC_KEY=
FLEXFACTOR_FALLBACK_OPENAI_KEY=

# Local models. LOOPBACK ONLY - a non-loopback host is refused, by design:
# the Ollama path is the one that guarantees nothing leaves the machine.
OLLAMA_BASE_URL=http://127.0.0.1:11434
FLEXFACTOR_OLLAMA_CONCURRENCY=2
FLEXFACTOR_OLLAMA_TIMEOUT=
# Reasoning channel stays OFF: a thinking model that spends its whole budget
# reasoning returns no answer at all. Set to 1 only when debugging that.
FLEXFACTOR_OLLAMA_THINK=

# GitHub, used read-only as the SPDX oracle for competitor research. Only
# raises the rate limit; research works without it.
GITHUB_TOKEN=
GH_TOKEN=
FLEXFACTOR_GITHUB_OWNER=

# --------------------------------------------------------------------------- #
# Route rotation (AI Time catalog)
# --------------------------------------------------------------------------- #
AI_ROTATE=                      # "off" restores the pre-rotation provider path
AI_ROTATE_PIN=                  # pin one route id (debugging a single backend)
AI_ROTATE_CATALOG=              # override %LOCALAPPDATA%\AITime\routes.json
AI_ROTATE_STATE=                # override the rotation state file
AITIME_STATE_DIR=
FLEXFACTOR_AITIME_CONFIG=
FLEXFACTOR_ROTATION_EXCLUDE=    # substring; excludes matching routes
FLEXFACTOR_ROTATION_EXTENSIONS= # 1 enables the extension test surface
# "full" disables the reasoning-down knob on rotated cloud routes.
FLEXFACTOR_CLOUD_REASONING=

# Shared admission across concurrent FlexFactor processes. The state ledger
# defaults to ~/.flexfactor/provider-capacity.json; either path can be moved for
# a service account or portable install. MAX_INFLIGHT overrides the per-allowance
# defaults (free/subscription 1, local 2, other 4). WAIT_MAX_S bounds both queue
# admission and rotation retries; the shipped default is 12 hours (43200s).
FLEXFACTOR_STATE_DIR=
FLEXFACTOR_PROVIDER_CAPACITY_STATE=
FLEXFACTOR_PROVIDER_MAX_INFLIGHT=
FLEXFACTOR_PROVIDER_WAIT_MAX_S=43200

# --------------------------------------------------------------------------- #
# Timeouts and paid-rescue bounds - READ THE NUMBERS BEFORE CHANGING THEM
# --------------------------------------------------------------------------- #
# A healthy free-proxy judge ping MEASURED 307.8s on the reference machine
# (PROVIDER_MAX_CONCURRENCY=2, nearly all of it queueing). A stream timeout
# below that floor silently converts a free setup into a metered one, so values
# under the floor are clamped up and logged.
FLEXFACTOR_STREAM_TIMEOUT=
FLEXFACTOR_STREAM_IDLE_TIMEOUT=
FLEXFACTOR_ALLOW_UNSAFE_TIMEOUT=   # 1 lets a sub-floor timeout stand (tests)
FLEXFACTOR_OPENAI_CALL_TIMEOUT=
FLEXFACTOR_FALLBACK_HOLD=          # seconds the paid hold lasts (default 300)
FLEXFACTOR_PAID_RESCUE_PER_HOUR=   # rate cap (default 40)
FLEXFACTOR_PAID_RESCUE_CONCURRENCY=  # concurrent rescues (default 3)

# --------------------------------------------------------------------------- #
# Sweep shape - how much work goes into one call, and how long one file may take
# --------------------------------------------------------------------------- #
FLEXFACTOR_REVIEW_FIX_BATCH_SIZE=8          # files per review+fix batch
FLEXFACTOR_SEMANTIC_REVIEW_BATCH_CHARS=48000  # chars packed into one review call
FLEXFACTOR_OLLAMA_MAX_REVIEW_BYTES=12000    # local models get a smaller unit
# Hard ceiling on ONE file's fix generation. It bounds the prefetch wait AND the
# inline path; a stream that dribbles one event per idle window would otherwise
# never time out (measured: a 25-minute freeze on a single file, 2026-08-14).
FLEXFACTOR_FIX_FILE_MAX_SECONDS=900
# Independent purpose assessments folded by majority vote. The criteria score is
# an ASSESSMENT, not a measurement - the same tree scored 2/10, 0/10 and 3/10 on
# three runs - so 1 sample reports variance UNMEASURED, which is not "stable".
FLEXFACTOR_PURPOSE_SAMPLES=3

# --------------------------------------------------------------------------- #
# Repo Rewards (scout + competitor research backend)
# --------------------------------------------------------------------------- #
FLEXFACTOR_REPO_REWARDS_URL=http://localhost:3000
FLEXFACTOR_REPO_REWARDS_PRODUCTION_URL=

# --------------------------------------------------------------------------- #
# Safety gates - each one widens what a run may do. Defaults are the safe side.
# --------------------------------------------------------------------------- #
# Command classes the policy gate may run (destructive/credentialed/deploy are
# refused by default with rc 126). Comma-separated.
FLEXFACTOR_ALLOW_CLASSES=
# Egress categories allowed past the secret/PII scanner before a cloud call.
FLEXFACTOR_ALLOW_EGRESS=
# Repositories authorized to execute their own build/test commands on a host
# with no OS sandbox. Semicolon-separated absolute paths.
FLEXFACTOR_TRUSTED_REPOS=
# Send program-derived queries to a non-local Repo Rewards / program context.
# NOTE: an UNSET variable is not an opt-out; set to 0 to refuse.
FLEXFACTOR_ALLOW_REMOTE_REPO_REWARDS=
FLEXFACTOR_ALLOW_REMOTE_PROGRAM_CONTEXT=

# --------------------------------------------------------------------------- #
# Discovery, journeys and research
# --------------------------------------------------------------------------- #
FLEXFACTOR_PROJECT_ROOTS=       # extra dirs to resolve `--program <name>` in
FIRECRAWL_API_KEY=              # official Firecrawl cloud bearer token
FLEXFACTOR_FIRECRAWL_URL=       # optional self-hosted/compatible v2 endpoint
FLEXFACTOR_FIRECRAWL_API_KEY=   # optional key scoped only to the custom endpoint
FLEXFACTOR_SEARXNG_URL=         # owner-hosted fallback after Firecrawl
FLEXFACTOR_CURSOR_PROBE=
FLEXFACTOR_E2E_ROLES=           # JSON: roles the UI explorer signs in as
FLEXFACTOR_E2E_VIEWPORTS=
FLEXFACTOR_E2E_MAX_PAGES=
# Read by flexfactor_assets/flexfactor_explorer.js (node), not by the Python
# runtime. Every browser action races the ACTION deadline, so a hang becomes a
# named `timeout` finding rather than a stall - and a timeout blocks
# completeness on purpose. Raise it on a slow host; do not lower it to hide one.
FLEXFACTOR_E2E_ACTION_TIMEOUT_MS=15000
FLEXFACTOR_E2E_RUN_TIMEOUT_MS=600000
# 1 permits REAL form submissions and failure-case exercises in the journey
# engine. Without it those steps are skipped - and every skip is named.
FLEXFACTOR_E2E_ISOLATED=

# --------------------------------------------------------------------------- #
# Desktop launchers (flexfactor_launch.ps1 / _scout_ / _audit_, via
# scripts\flexfactor_python.ps1)
# --------------------------------------------------------------------------- #
# Which interpreter the launchers run. Unset, they prefer the checkout's own
# `.venv\Scripts\python.exe` (where `pip install -e ".[all]"` puts the provider
# SDKs), then `py -3.12`, then whatever `python` is on PATH. Set this to pin one
# on a host with several Pythons.
FLEXFACTOR_PYTHON=

# --------------------------------------------------------------------------- #
# Runtime-data evidence, PHASE 1c (flexfactor_prodevidence.py)
#
# Reading source can only ever produce a CODE verdict. This phase opens ONE
# read-only connection to production and turns what the rows demonstrate into
# non-code findings for the owner. Unset means the phase reports UNAVAILABLE and
# says so - it never renders as "no data problems found".
# --------------------------------------------------------------------------- #
# The read-only connection string. A per-program spelling
# (FLEXFACTOR_READONLY_DATABASE_URL__<PROGRAM>, program name upper-cased with
# non-alphanumerics as _) wins over this one, and is REQUIRED when a single
# invocation audits more than one program - one database is not every program's
# database, and diagnosing B from A's rows would attach the wrong evidence to
# the wrong report.
FLEXFACTOR_READONLY_DATABASE_URL=
# Per-statement bound, milliseconds. Clamped to [1000, 120000]; default 15000.
FLEXFACTOR_READONLY_STATEMENT_TIMEOUT_MS=
# Bound on the CONNECTION attempt itself, seconds. Clamped to [1, 60]; default
# 10. statement_timeout is installed only after the connection succeeds, so
# without this an unreachable host could stall the audit from inside a phase
# that is explicitly non-fatal.
FLEXFACTOR_DB_CONNECT_TIMEOUT_S=
# Row bound for the information_schema read only (metadata, not production
# data); default 20000. Filling it means the schema handed to the planner may be
# a PREFIX of the real one, which the run says out loud rather than presenting
# the truncated subset as the whole schema.
FLEXFACTOR_SCHEMA_ROW_LIMIT=

# --------------------------------------------------------------------------- #
# Self-audit helper (flexfactor_self_audit_report.py)
# --------------------------------------------------------------------------- #
FF_SELF_AUDIT_PROVIDER=
FF_SELF_AUDIT_OUT_DIR=

# --------------------------------------------------------------------------- #
# Managed Android control plane (`cloud/`). The registered public client ID has
# a checked-in production default. GitHub device-flow exchange and refresh do
# not require a client secret.
# --------------------------------------------------------------------------- #
GITHUB_OAUTH_CLIENT_ID=

# --------------------------------------------------------------------------- #
# TEST HARNESS ONLY - read by test_flexfactor_journeys.py, never by the runtime.
# Listed so the CI environment is documented in one place, and marked so nobody
# sets them expecting the tool itself to react.
# --------------------------------------------------------------------------- #
FLEXFACTOR_PLAYWRIGHT_NODE_MODULES=   # where the Playwright install lives
FLEXFACTOR_E2E_DEBUG_LOG=             # keep the explorer log for CI forensics
