# FlexFactor 0.6.2 configuration template.
#
# FlexFactor does not load this file itself. Export only the values you use.
# Every production call follows the same best-available ladder; credentials add
# capacity to that ladder and never select a paid/free/provider route.

# Optional paid/subscription capacity. The strongest usable account is tried
# first, and quota/credit exhaustion advances the same call down the ladder.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COPILOT_GITHUB_TOKEN=

# Optional local/free fallback. Ollama is loopback-only.
OLLAMA_BASE_URL=http://127.0.0.1:11434
FLEXFACTOR_OLLAMA_CONCURRENCY=1
FLEXFACTOR_OLLAMA_TIMEOUT=
FLEXFACTOR_OLLAMA_THINK=
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
FLEXFACTOR_FALLBACK_ANTHROPIC_KEY=
FLEXFACTOR_FALLBACK_OPENAI_KEY=

# GitHub metadata/research access for desktop runs.
GITHUB_TOKEN=
GH_TOKEN=
FLEXFACTOR_GITHUB_OWNER=

# Durable orchestrator, checkpoint, and provider-capacity state.
FLEXFACTOR_STATE_DIR=
FLEXFACTOR_QUEUE_ID=
FLEXFACTOR_QUEUE_STATE=
# Optional standing prompt for the single target in a cloud/mobile run. Desktop
# users normally save this per program in the FlexFactor dashboard or pass
# --guiding-prompt once per --program; leave unset for no run-input override.
FLEXFACTOR_GUIDING_PROMPT=
# Optional one-run prompt spanning every --program target. Named requirements
# are routed to that repo; unscoped requirements apply to every selected repo.
FLEXFACTOR_SESSION_PROMPT=
FLEXFACTOR_PROVIDER_CAPACITY_STATE=
FLEXFACTOR_PROVIDER_MAX_INFLIGHT=
FLEXFACTOR_PROVIDER_WAIT_MAX_S=43200

# AI Time catalog integration. Pins cannot override best-available production
# ordering; they remain diagnostic inputs to non-product rotator clients.
AI_ROTATE_CATALOG=
AI_ROTATE_STATE=
AI_ROTATE=
AI_ROTATE_PIN=
AITIME_STATE_DIR=
FLEXFACTOR_AITIME_CONFIG=
FLEXFACTOR_ROTATION_EXCLUDE=
FLEXFACTOR_ROTATION_EXTENSIONS=
FLEXFACTOR_CLOUD_REASONING=
FLEXFACTOR_CODEX_AUTH_FILE=
FLEXFACTOR_CLI_TIMEOUT=600
FLEXFACTOR_CURSOR_BASE_URL=
FLEXFACTOR_CURSOR_API_KEY=

# Provider and per-file bounds.
FLEXFACTOR_STREAM_TIMEOUT=
FLEXFACTOR_STREAM_IDLE_TIMEOUT=
FLEXFACTOR_ALLOW_UNSAFE_TIMEOUT=
FLEXFACTOR_OPENAI_CALL_TIMEOUT=
FLEXFACTOR_FALLBACK_HOLD=300
FLEXFACTOR_PAID_RESCUE_PER_HOUR=40
FLEXFACTOR_PAID_RESCUE_CONCURRENCY=3
FLEXFACTOR_REVIEW_FIX_BATCH_SIZE=8
FLEXFACTOR_SEMANTIC_REVIEW_BATCH_CHARS=48000
FLEXFACTOR_FIX_FILE_MAX_SECONDS=900
FLEXFACTOR_PURPOSE_SAMPLES=3
# Optional local Tenets context ranking. Ranking changes priority only; canonical
# audit membership, verification, and release gates remain authoritative.
# Set FLEXFACTOR_TENETS=0 to disable local ranking.
# FLEXFACTOR_TENETS_TASK, when non-empty, overrides the ranking task for every target.
FLEXFACTOR_TENETS=1
FLEXFACTOR_TENETS_TASK=
# Linux only: owner-delegated cgroup-v2 directory exposing memory, pids, and
# cgroup.kill. Without it, optional ranking stays disabled (canonical audit
# membership/order and every production gate continue normally).
FLEXFACTOR_TENETS_CGROUP_ROOT=

# Research and competitor evidence.
# Number of corroborated competitors requested per research gate. Default: 25.
FLEXFACTOR_COMPETITOR_TARGET=25
# Maximum accepted competitor capabilities entering the fix stream. Default: 25; 0 explicitly disables fixes for that run.
FLEXFACTOR_COMPETITOR_FIXES=25
# Maximum Scout opportunities consumed by competitor research. Default: 25.
FLEXFACTOR_SCOUT_OPPORTUNITIES=25
# Orchestrator-wide competitor target/default used when a run does not override it. Default: 25.
FLEXFACTOR_TOP_COMPETITORS=25
FLEXFACTOR_REPO_REWARDS_URL=http://localhost:3000
FLEXFACTOR_REPO_REWARDS_PRODUCTION_URL=
FIRECRAWL_API_KEY=
FLEXFACTOR_FIRECRAWL_URL=
FLEXFACTOR_FIRECRAWL_API_KEY=
FLEXFACTOR_SEARXNG_URL=
FLEXFACTOR_ALLOW_REMOTE_REPO_REWARDS=
FLEXFACTOR_ALLOW_REMOTE_PROGRAM_CONTEXT=
FLEXFACTOR_CURSOR_PROBE=

# Security/trust gates. Each non-empty value widens authority; keep unset unless
# the owner has made the corresponding decision.
FLEXFACTOR_ALLOW_CLASSES=
FLEXFACTOR_ALLOW_EGRESS=
FLEXFACTOR_TRUSTED_REPOS=

# Repository discovery and browser journeys.
FLEXFACTOR_PROJECT_ROOTS=
FLEXFACTOR_E2E_ROLES=
FLEXFACTOR_E2E_VIEWPORTS=
FLEXFACTOR_E2E_MAX_PAGES=
FLEXFACTOR_E2E_ACTION_TIMEOUT_MS=15000
FLEXFACTOR_E2E_RUN_TIMEOUT_MS=600000
FLEXFACTOR_E2E_ISOLATED=

# Read-only production-data evidence. Use a least-privilege account.
FLEXFACTOR_READONLY_DATABASE_URL=
FLEXFACTOR_READONLY_STATEMENT_TIMEOUT_MS=
FLEXFACTOR_DB_CONNECT_TIMEOUT_S=
FLEXFACTOR_SCHEMA_ROW_LIMIT=

# Desktop interpreter.
FLEXFACTOR_PYTHON=

# Managed OAuth client override. Production has a registered checked-in public
# client ID; device flow requires no client secret.
GITHUB_OAUTH_CLIENT_ID=

# Final protected-branch wait. Timeout leaves the run incomplete.
FLEXFACTOR_PUBLISH_WAIT_SECONDS=900

# Test harness only.
FLEXFACTOR_PLAYWRIGHT_NODE_MODULES=
FLEXFACTOR_E2E_DEBUG_LOG=
