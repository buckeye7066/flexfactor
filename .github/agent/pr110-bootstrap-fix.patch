+class AutocleanPreBootstrapGateTests(unittest.TestCase):
+    """Missing verification dependencies are UNKNOWN here, never a code RED."""
+
+    def setUp(self):
+        import flexfactor as ff
+        self.ff = ff
+
+    def test_unbootstrapped_candidate_is_deferred_without_running_the_gate(self):
+        calls = []
+        real = self.ff._publication_gate
+        self.ff._publication_gate = (
+            lambda *a, **k: calls.append((a, k)) or (True, "wrong")
+        )
+        try:
+            verdict, note = self.ff._autoclean_publication_gate(
+                ".", {
+                    "verification_is_real": False,
+                    "verification_note": "dependencies not installed for node:.",
+                })
+        finally:
+            self.ff._publication_gate = real
+        self.assertIs(verdict, None)
+        self.assertEqual(calls, [])
+        self.assertIn("deferred until after dependency bootstrap", note)
+        self.assertIn("dependencies not installed", note)
+
+    def test_bootstrapped_candidate_uses_the_real_publication_gate(self):
+        calls = []
+        real = self.ff._publication_gate
+        self.ff._publication_gate = (
+            lambda project, stack: calls.append((project, stack)) or (True, "green")
+        )
+        stack = {"verification_is_real": True}
+        try:
+            verdict = self.ff._autoclean_publication_gate("repo", stack)
+        finally:
+            self.ff._publication_gate = real
+        self.assertEqual(verdict, (True, "green"))
+        self.assertEqual(calls, [("repo", stack)])
+
+    def test_clean_repo_is_wired_to_the_deferred_gate(self):
+        with open(self.ff.__file__, encoding="utf-8") as source_file:
+            source = source_file.read()
+        self.assertIn(
+            "verify=lambda: _autoclean_publication_gate(\n"
+            "                        project_dir, stack)",
+            source,
+        )
+
+
 if __name__ == "__main__":
     unittest.main(verbosity=2)
