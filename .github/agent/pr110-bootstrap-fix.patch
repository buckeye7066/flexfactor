+def _autoclean_publication_gate(project_dir: str,
+                                stack: dict) -> tuple[bool | None, str]:
+    """Verify a frozen pre-work candidate without inventing a bootstrap failure.
+
+    Autoclean runs before the normal dependency-bootstrap phase because it must
+    isolate and commit the tree that was already on disk before new work starts.
+    When verification dependencies are not ready yet, running the ordinary
+    publication gate here would label healthy source RED for a missing
+    ``node_modules``/venv/toolchain. That is not a code verdict. Keep the exact
+    candidate UNVERIFIED and let the post-bootstrap baseline gate evaluate it.
+    """
+    if stack.get("verification_is_real") is not True:
+        why = str(stack.get("verification_note") or
+                  "verification dependencies are not ready")
+        return (None,
+                "autoclean publication gate deferred until after dependency "
+                f"bootstrap: {why}")
+    return _publication_gate(project_dir, stack)
+
