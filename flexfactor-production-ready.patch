+  package-artifact:
+    name: package-artifact
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+      - name: Build exact-commit wheel
+        run: |
+          python -m pip wheel . --no-deps --wheel-dir dist
+          python -m pip install --force-reinstall --no-deps dist/*.whl
+          python - <<'PY'
+          import flexfactor
+          assert flexfactor.TOOL_VERSION == "0.4.1", flexfactor.TOOL_VERSION
+          PY
+      - name: Record SHA-256 checksums
+        run: |
+          python - <<'PY'
+          import glob
+          import hashlib
+          from pathlib import Path
+
+          wheels = sorted(glob.glob("dist/*.whl"))
+          if not wheels:
+              raise SystemExit("wheel build produced no artifact")
+          lines = []
+          for filename in wheels:
+              digest = hashlib.sha256(Path(filename).read_bytes()).hexdigest()
+              lines.append(f"{digest}  {Path(filename).name}")
+          Path("dist/SHA256SUMS").write_text("\n".join(lines) + "\n", encoding="utf-8")
+          PY
+      - name: Upload exact-commit release candidate
+        uses: actions/upload-artifact@v4
+        with:
+          name: flexfactor-0.4.1-${{ github.sha }}
+          path: dist/*
+          if-no-files-found: error
+          retention-days: 90
